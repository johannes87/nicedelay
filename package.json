{
  "name": "nicedelay",
  "version": "0.1.0",
  "private": true,
  "description": "Instant stream delay for OBS: always recording, so delay starts without waiting, with on-stream rewind animations",
  "type": "module",
  "main": "src/server/server.ts",
  "scripts": {
    "start": "node src/server/server.ts",
    "dev": "node --watch-path=src/server --watch-path=src/shared src/server/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc -p . && tsc -p src/web",
    "lint": "oxlint --type-aware",
    "lint:sonar": "tools/sonar/node_modules/.bin/eslint --config tools/sonar/eslint.config.js --max-warnings 0 src test vite.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm run lint:sonar && npm run format:check && npm test",
    "fake-obs": "scripts/fake-obs.sh",
    "postinstall": "npm --prefix tools/sonar install --no-audit --no-fund --loglevel=error"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents": false
  }
}
